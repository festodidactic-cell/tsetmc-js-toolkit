true==function()
{
    /*
    ================================================================
    E3C-G
    Elliott Golden Confluence
    ---------------------------------------------------------------
    ONLINE HIGH-CONFLUENCE WAVE-3 ENGINE

    ساختار:
    1) ساختار احتمالی Wave 1 -> Wave 2
    2) عدم ابطال Wave 2
    3) اصلاح منطقی
    4) واگرایی مثبت یا مثبت مخفی همزمان:
       RSI + MFI + CCI + MACD
    5) افزایش حجم جاری
    6) قدرت خریدار حقیقی
    7) غلبه خرید حقیقی بر فروش حقیقی
    8) حرکت مثبت کوتاه مدت
    9) شکست/بازپس گیری مقاومت کوتاه مدت
    10) نقدشوندگی
    11) جلوگیری از شکار سهم های بیش از حد فرارکرده
    12) جلوگیری از خروجی گرفتن از سهم های کاملاً قفل شده
    13) کنترل کیفیت داده تاریخی

    این فیلتر:
    - سیگنال قطعی خرید نیست
    - مجوز ورود نیست
    - یک High-Confluence Watch/Trigger است
    ================================================================
    */


    /* ============================================================
       کنترل اولیه داده
       ============================================================ */

    if(typeof [ih]=="undefined")
        return false;

    if([ih].length<70)
        return false;


    var N=Math.min([ih].length,100);


    /* ============================================================
       آرایه قیمت
       ============================================================ */

    var C=[];
    var H=[];
    var L=[];
    var V=[];


    for(var i=0;i<N;i++)
    {
        C[i]=[ih][i].PClosing;
        H[i]=[ih][i].PriceMax;
        L[i]=[ih][i].PriceMin;
        V[i]=[ih][i].QTotTran5J;

        if(
            C[i]<=0 ||
            H[i]<=0 ||
            L[i]<=0 ||
            V[i]<0
        )
            return false;
    }


    /* ============================================================
       Pivot Low
       ============================================================ */

    var isLow=function(i)
    {
        if(i<3 || i>N-4)
            return false;

        return(
            L[i]<=L[i-1] &&
            L[i]<=L[i-2] &&
            L[i]<=L[i+1] &&
            L[i]<=L[i+2]
        );
    };


    /* ============================================================
       Pivot High
       ============================================================ */

    var isHigh=function(i)
    {
        if(i<3 || i>N-4)
            return false;

        return(
            H[i]>=H[i-1] &&
            H[i]>=H[i-2] &&
            H[i]>=H[i+1] &&
            H[i]>=H[i+2]
        );
    };


    /* ============================================================
       پیدا کردن دو کف مهم اخیر
       ============================================================ */

    var lowA=-1;
    var lowB=-1;
    var lowC=-1;


    for(var i=4;i<N-4;i++)
    {
        if(isLow(i))
        {
            if(lowA==-1)
                lowA=i;
            else if(lowB==-1)
                lowB=i;
            else
            {
                lowC=i;
                break;
            }
        }
    }


    if(
        lowA==-1 ||
        lowB==-1 ||
        lowC==-1
    )
        return false;


    /*
    lowC قدیمی ترین
    lowB وسط
    lowA جدیدترین
    */


    /* ============================================================
       پیدا کردن سقف بین کف قدیمی و کف میانی
       = کاندید Wave 1 High
       ============================================================ */

    var wave1Index=-1;

    for(var i=lowB+1;i<lowC;i++)
    {
        if(isHigh(i))
        {
            wave1Index=i;
            break;
        }
    }


    if(wave1Index==-1)
        return false;


    var wave0=L[lowC];
    var wave1=H[wave1Index];
    var wave2=L[lowB];

    var current=PClosing;


    /* ============================================================
       Wave 1 باید حرکت واقعی داشته باشد
       ============================================================ */

    if(wave1<=wave0)
        return false;


    var wave1Move=
        (wave1-wave0)/wave0;


    if(wave1Move<0.06)
        return false;


    /* ============================================================
       Wave 2 نباید Origin را بشکند
       ============================================================ */

    if(wave2<=wave0)
        return false;


    /* ============================================================
       عمق اصلاح Wave 2
       ============================================================ */

    var retracement=
        (wave1-wave2)/
        (wave1-wave0);


    if(
        retracement<0.382 ||
        retracement>0.786
    )
        return false;


    /*
    اصلاح های بسیار عمیق هنوز ممکن است از نظر الیوت مجاز باشند،
    اما برای یک سیستم کم ریسک امتیاز/کیفیت کمتری دارند.
    */


    /* ============================================================
       قیمت فعلی نباید کف Wave 2 را شکسته باشد
       ============================================================ */

    if(current<=wave2)
        return false;


    /* ============================================================
       Recovery از Wave 2
       ============================================================ */

    var recovery=
        (current-wave2)/wave2;


    /*
    هنوز باید در بخش ابتدایی حرکت باشیم.
    */

    if(recovery<0.01)
        return false;

    if(recovery>0.18)
        return false;


    /* ============================================================
       RSI
       ============================================================ */

    var rsiPeriod=14;
    var rsi=[];

    for(var i=0;i<N;i++)
        rsi[i]=50;


    var gain=0;
    var loss=0;


    for(var i=N-2;i>=0;i--)
    {
        var ch=C[i]-C[i+1];

        if(ch>0)
            gain+=ch;
        else
            loss-=ch;

        if(
            i<=N-2-rsiPeriod &&
            gain+loss>0
        )
        {
            var rs=gain/(loss==0?0.000001:loss);
            rsi[i]=100-(100/(1+rs));
        }
    }


    /* ============================================================
       CCI 20
       ============================================================ */

    var cci=[];

    for(var i=0;i<N;i++)
        cci[i]=0;


    var cciPeriod=20;


    for(var i=0;i<N-cciPeriod;i++)
    {
        var sum=0;

        for(var j=i;j<i+cciPeriod;j++)
            sum+=(H[j]+L[j]+C[j])/3;


        var mean=sum/cciPeriod;

        var dev=0;

        for(var j=i;j<i+cciPeriod;j++)
            dev+=Math.abs(
                ((H[j]+L[j]+C[j])/3)-mean
            );


        dev/=cciPeriod;

        if(dev>0)
        {
            cci[i]=
                (((H[i]+L[i]+C[i])/3)-mean)/
                (0.015*dev);
        }
    }


    /* ============================================================
       MFI 14
       ============================================================ */

    var mfi=[];
    var mfiPeriod=14;

    for(var i=0;i<N;i++)
        mfi[i]=50;


    for(var i=0;i<N-mfiPeriod;i++)
    {
        var positive=0;
        var negative=0;

        for(var j=i;j<i+mfiPeriod;j++)
        {
            var tp=
                (H[j]+L[j]+C[j])/3;

            var prevTp=
                (H[j+1]+L[j+1]+C[j+1])/3;

            var money=
                tp*V[j];

            if(tp>prevTp)
                positive+=money;
            else if(tp<prevTp)
                negative+=money;
        }


        if(negative==0)
            mfi[i]=100;
        else
        {
            var mr=positive/negative;

            mfi[i]=
                100-(100/(1+mr));
        }
    }


    /* ============================================================
       MACD 12/26
       ============================================================ */

    var ema12=[];
    var ema26=[];
    var macd=[];


    for(var i=0;i<N;i++)
    {
        ema12[i]=C[i];
        ema26[i]=C[i];
        macd[i]=0;
    }


    var a12=2/(12+1);
    var a26=2/(26+1);


    for(var i=N-2;i>=0;i--)
    {
        ema12[i]=
            C[i]*a12+
            ema12[i+1]*(1-a12);

        ema26[i]=
            C[i]*a26+
            ema26[i+1]*(1-a26);

        macd[i]=
            ema12[i]-ema26[i];
    }


    /* ============================================================
       تابع تشخیص واگرایی مثبت / مثبت مخفی
       ============================================================ */

    var bullishDivergence=function(priceOld,priceNew,indOld,indNew)
    {
        /*
        Regular bullish:
        قیمت کف جدید پایین تر
        اندیکاتور کف جدید بالاتر

        Hidden bullish:
        قیمت کف جدید بالاتر
        اندیکاتور کف جدید پایین تر
        */

        var regular=
            priceNew<priceOld &&
            indNew>indOld;

        var hidden=
            priceNew>priceOld &&
            indNew<indOld;

        return regular || hidden;
    };


    /* ============================================================
       چهار واگرایی مستقل
       ============================================================ */

    var rsiDiv=
        bullishDivergence(
            C[lowC],
            C[lowB],
            rsi[lowC],
            rsi[lowB]
        );


    var mfiDiv=
        bullishDivergence(
            C[lowC],
            C[lowB],
            mfi[lowC],
            mfi[lowB]
        );


    var cciDiv=
        bullishDivergence(
            C[lowC],
            C[lowB],
            cci[lowC],
            cci[lowB]
        );


    var macdDiv=
        bullishDivergence(
            C[lowC],
            C[lowB],
            macd[lowC],
            macd[lowB]
        );


    /*
    ================================================================
    شرط طلایی:

    هر چهار واگرایی باید همزمان وجود داشته باشند.
    ================================================================
    */

    if(
        !rsiDiv ||
        !mfiDiv ||
        !cciDiv ||
        !macdDiv
    )
        return false;


    /* ============================================================
       تایید حجم
       ============================================================ */

    var avgVol=0;

    for(var i=1;i<=20 && i<N;i++)
        avgVol+=V[i];


    avgVol/=20;


    if(avgVol<=0)
        return false;


    var volumeRatio=
        (typeof tvol!="undefined" ?
        tvol :
        V[0])/
        avgVol;


    if(volumeRatio<1.15)
        return false;


    /* ============================================================
       قدرت خریدار حقیقی
       ============================================================ */

    if(typeof (ct)=="undefined")
        return false;


    if(
        (ct).Buy_CountI<=0 ||
        (ct).Sell_CountI<=0
    )
        return false;


    var buyPerCapita=
        (ct).Buy_I_Volume/
        (ct).Buy_CountI;


    var sellPerCapita=
        (ct).Sell_I_Volume/
        (ct).Sell_CountI;


    if(sellPerCapita<=0)
        return false;


    var buyerPower=
        buyPerCapita/
        sellPerCapita;


    /*
    خریدار حقیقی باید برتری واقعی داشته باشد.
    */

    if(buyerPower<1.15)
        return false;


    /* ============================================================
       خالص جریان حجم حقیقی
       ============================================================ */

    var netIndividual=
        (ct).Buy_I_Volume-
        (ct).Sell_I_Volume;


    if(netIndividual<=0)
        return false;


    /* ============================================================
       قدرت قیمت جاری
       ============================================================ */

    var livePrice=
        (typeof pl!="undefined" ? pl : current);

    var yesterday=
        (typeof py!="undefined" ? py : C[1]);


    if(livePrice<=yesterday)
        return false;


    /* ============================================================
       قیمت جاری نسبت به سقف/کف امروز
       ============================================================ */

    var liveHigh=
        (typeof pmax!="undefined" ? pmax : H[0]);

    var liveLow=
        (typeof pmin!="undefined" ? pmin : L[0]);


    if(liveHigh<=liveLow)
        return false;


    var closeStrength=
        (livePrice-liveLow)/
        (liveHigh-liveLow);


    if(closeStrength<0.60)
        return false;


    /* ============================================================
       Momentum کوتاه مدت
       ============================================================ */

    if(
        C[0]<=C[3] ||
        C[0]<=C[5]
    )
        return false;


    /* ============================================================
       شکست سقف کوتاه مدت
       ============================================================ */

    var shortResistance=0;


    for(var i=1;i<=12 && i<N;i++)
    {
        if(H[i]>shortResistance)
            shortResistance=H[i];
    }


    /*
    قیمت باید حداقل در حال بازپس گیری
    سقف کوتاه مدت باشد.
    */

    if(livePrice<shortResistance)
        return false;


    /* ============================================================
       فاصله بیش از حد از Wave 1 ممنوع
       ============================================================ */

    if(livePrice>wave1*1.10)
        return false;


    /* ============================================================
       نقدشوندگی بلندمدت
       ============================================================ */

    if(
        typeof [is1]=="undefined" ||
        typeof [is9]=="undefined"
    )
        return false;


    if([is1]<=0 || [is9]<=0)
        return false;


    /*
    حداقل گردش و تعداد معامله نسبی.
    */

    if(
        typeof tval!="undefined" &&
        tval<[is1]*0.10
    )
        return false;


    if(
        typeof tno!="undefined" &&
        tno<[is9]*0.25
    )
        return false;


    /* ============================================================
       کنترل سهم قفل شده در صف خرید
       ============================================================ */

    if(
        typeof tmax!="undefined" &&
        typeof pl!="undefined"
    )
    {
        /*
        اگر کاملاً به سقف مجاز چسبیده و
        فاصله عملیاتی وجود ندارد،
        خروجی نده.
        */

        if(
            pl>=tmax &&
            po1==tmax
        )
            return false;
    }


    /* ============================================================
       کنترل کف ساختاری
       ============================================================ */

    /*
    قیمت فعلی باید حداقل 1 درصد بالاتر
    از کف Wave 2 باشد.
    */

    if(
        livePrice<=wave2*1.01
    )
        return false;


    /* ============================================================
       تایید زمانی ساختار
       ============================================================ */

    var wave1Duration=
        Math.abs(lowC-wave1Index);

    var wave2Duration=
        Math.abs(wave1Index-lowB);


    if(
        wave1Duration<3 ||
        wave2Duration<3
    )
        return false;


    /*
    اصلاح خیلی سریع و یک کندلی،
    کیفیت ساختاری کمتری دارد.
    */

    if(
        wave2Duration<2
    )
        return false;


    /* ============================================================
       تایید نهایی
       ============================================================ */

    return true;

}()

